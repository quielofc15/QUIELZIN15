{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "digital",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-12",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "404-page"
  },
  "keep_vars": true
}
